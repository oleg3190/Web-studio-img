FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY . .
RUN go mod tidy
RUN go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker
FROM alpine:3.22
RUN addgroup -S app && adduser -S -G app app
WORKDIR /app
COPY --from=build /out/worker /app/worker
USER app
ENTRYPOINT ["/app/worker"]
